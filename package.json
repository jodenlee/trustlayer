{
  "name": "trustlayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TrustLayer milestone escrow and dispute-resolution protocol",
  "scripts": {
    "compile": "hardhat build",
    "test": "hardhat test",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "typecheck": "tsc --noEmit",
    "export:abis": "hardhat run scripts/export-abis.ts",
    "export:contracts": "hardhat run scripts/export-contracts.ts --network localhost",
    "verify:local": "hardhat run scripts/verify-local-deployment.ts",
    "web:dev": "npm --prefix apps/web run dev",
    "web:start": "npm --prefix apps/web run start",
    "web:lint": "npm --prefix apps/web run lint",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:build": "npm --prefix apps/web run build",
    "web:test": "npm --prefix apps/web test",
    "chain": "node --import tsx scripts/local-chain.ts",
    "verify:persistence": "node --import tsx apps/web/scripts/verify-chain-persistence.ts",
    "provision:wallets": "hardhat run scripts/provision-local-wallets.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "@types/node": "^22.0.0",
    "hardhat": "^3.0.0",
    "typescript": "~5.9.0",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "optionalDependencies": {
    "@foundry-rs/anvil-win32-amd64": "1.7.1"
  }
}
