{
  "name": "@trustlayer/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:sync": "node scripts/sync-deployment.mjs",
    "predev": "npm run contracts:sync",
    "prebuild": "npm run contracts:sync",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "test:unit": "tsx --test unit/*.test.ts",
    "format": "prettier --write src tests unit test-support scripts *.ts *.mjs *.json",
    "format:check": "prettier --check src tests unit test-support scripts *.ts *.mjs *.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.108.0",
    "@trustlayer/contracts": "file:../../packages/contracts",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.58.0",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "~5.9.0"
  }
}
