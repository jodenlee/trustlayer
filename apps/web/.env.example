# Server-only. Never prefix these with NEXT_PUBLIC_ or commit actual values.
# Supabase direct/session-pooler Postgres URL. Use a dedicated login granted
# trustlayer_server after applying migrations as the database owner.
DATABASE_URL=postgresql://trustlayer_app:REPLACE_ME@127.0.0.1:5432/trustlayer
# Exactly the browser origin, no trailing slash. next dev supports local HTTP.
# Production requires HTTPS and Secure __Host- cookies.
AUTH_ORIGIN=http://127.0.0.1:3000
# Optional PEM root certificate for a hosted database (literal \n accepted).
# DATABASE_CA_CERT=
# Migration owner URL is used only by db:migrate, never by route handlers.
# It takes precedence over DATABASE_URL (including inherited shell variables).
# For Supabase Session Pooler, copy its owner URI on port 5432, database postgres.
# Substitute the actual URL-encoded password without template square brackets.
# Hosted shape (placeholders only):
# DATABASE_MIGRATION_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DB_PASSWORD@POOLER_HOST:5432/postgres
# DATABASE_MIGRATION_URL=postgresql://postgres:REPLACE_ME@127.0.0.1:5432/trustlayer

# Phase 4B private Storage: server-only, never NEXT_PUBLIC_. No actual values here.
# Keep the existing DATABASE_URL working; runtime-role separation is Phase 5 hardening.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LEGACY_SERVICE_ROLE_JWT
# SUPABASE_STORAGE_BUCKET=trustlayer-private
# UPLOAD_MAX_BYTES=10485760
# Create a PRIVATE bucket with the matching MIME/size restrictions. See docs/PHASE4B.md.
